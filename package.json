{
  "name": "vortexwebbrowser",
  "version": "0.5.0",
  "description": "A fast, lightweight web browser built with Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint main.js tests/**/*.js src/**/*.js",
    "check": "npm run lint && npm run security:test",
    "benchmark": "node scripts/benchmark-startup.js",
    "security:test": "node tests/security-audit.js",
    "build": "electron-builder --win --publish=never",
    "build:portable": "electron-builder --win portable --publish=never",
    "build:dir": "electron-builder --win --dir",
    "build:zip": "electron-builder --win zip",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "dist": "electron-builder --publish=never",
    "publish": "electron-builder --win --publish=always",
    "draft": "electron-builder --win --publish=onTagOrDraft"
  },
  "keywords": [],
  "author": "H0l10W",
  "license": "ISC",
  "homepage": "https://github.com/H0l10W/web-browser-with-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/H0l10W/Vortex-web-browser.git"
  },
  "dependencies": {
    "@cliqz/adblocker": "^1.26.15",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.37.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "com.h0l10w.vortexwebbrowser",
    "productName": "VortexBrowser",
    "publish": {
      "provider": "github",
      "owner": "H0l10W",
      "repo": "Vortex-web-browser"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/.git/**/*",
      "!**/.vs/**/*",
      "!**/.vscode/**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*",
      "!docs/**/*",
      "!tests/**/*",
      "!scripts/**/*",
      "!src/README.md",
      "!*.sln",
      "!*.esproj",
      "!*.log",
      "!obj/**/*",
      "!cert.p12",
      "!icons/*.crdownload",
      "!security-test-report-*.txt"
    ],
    "compression": "normal",
    "asar": true,
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/app-icon.png",
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "VortexBrowser-Portable-${version}.${ext}",
      "unpackDirName": "VortexBrowser"
    },
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML File",
        "description": "Open with Vortex Browser",
        "role": "Viewer"
      },
      {
        "ext": [
          "mhtml",
          "mht"
        ],
        "name": "MHTML File",
        "description": "Open with Vortex Browser",
        "role": "Viewer"
      }
    ],
    "protocols": [
      {
        "name": "HTTP URL",
        "schemes": [
          "http"
        ]
      },
      {
        "name": "HTTPS URL",
        "schemes": [
          "https"
        ]
      }
    ]
  }
}
